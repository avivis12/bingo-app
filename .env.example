# --- Database ---
# חיבור ל-PostgreSQL. אפשר להריץ Postgres מקומי, או שירות כמו Neon/Supabase/Railway (יש להם free tier).
DATABASE_URL="postgresql://user:password@localhost:5432/bingo?schema=public"

# --- Auth.js (NextAuth) ---
# מפתח סודי לחתימת ה-session. ליצירה: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Real-time (בחרו ספק אחד, ראו README) ---
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""
